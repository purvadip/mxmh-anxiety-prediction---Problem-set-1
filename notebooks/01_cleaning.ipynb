 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Data Cleaning Pipeline\n",
    "\n",
    "This notebook cleans the MXMH survey data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Settings\n",
    "# ----------------------------\n",
"import pandas as pd"
"from pathlib import Path"
"PREFERRED_FILES = [\n",
    "    \"mxmh_survey_results.csv\",\n",
    "]\n",
    "\n",
    "# Resolve paths relative to the notebook location\n",
    "PROJECT_ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "RAW_DIR      = PROJECT_ROOT / \"data\" / \"raw\"\n",
    "PROCESSED_DIR = PROJECT_ROOT / \"data\" / \"processed\"\n",
    "PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "OUTPUT_FILE = \"mxmh_clean.csv\"\n",
    "TARGET_COL = \"anxiety\"   # options: anxiety, depression, insomnia, ocd\n",
    "HIGH_THRESHOLD = 7       # for classification target"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Helpers\n",
    "# ----------------------------\n",
    "def find_data_file() -> Path:\n",
    "    # Search in the raw data directory\n",
    "    for name in PREFERRED_FILES:\n",
    "        p = RAW_DIR / name\n",
    "        if p.exists():\n",
    "            return p\n",
    "\n",
    "    # fallback: pick first csv/xlsx in raw folder\n",
    "    candidates = list(RAW_DIR.glob(\"*.csv\")) + list(RAW_DIR.glob(\"*.xlsx\")) + list(RAW_DIR.glob(\"*.xls\"))\n",
    "    if candidates:\n",
    "        return candidates[0]\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "        f\"No dataset found in {RAW_DIR}. Expected one of {PREFERRED_FILES} \"\n",
    "        f\"or any .csv/.xlsx file in data/raw/.\"\n",
    "    )\n",
    "\n",
    "def read_table(path: Path) -> pd.DataFrame:\n",
    "    if path.suffix.lower() in [\".xlsx\", \".xls\"]:\n",
    "        return pd.read_excel(path)\n",
    "\n",
    "    # CSV: try normal read, then common fallbacks\n",
    "    try:\n",
    "        return pd.read_csv(path)\n",
    "    except UnicodeDecodeError:\n",
    "        return pd.read_csv(path, encoding=\"latin-1\")\n",
    "    except pd.errors.ParserError:\n",
    "        # try semicolon delimiter, then python engine\n",
    "        try:\n",
    "            return pd.read_csv(path, sep=\";\")\n",
    "        except Exception:\n",
    "            return pd.read_csv(path, engine=\"python\")\n",
    "\n",
    "def clean_columns(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df = df.copy()\n",
    "    df.columns = (\n",
    "        df.columns.astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .str.replace(\" \", \"_\")\n",
    "        .str.replace(\"/\", \"_\")\n",
    "        .str.replace(\"-\", \"_\")\n",
    "        .str.replace(r\"[^\\w_]\", \"\", regex=True)\n",
    "    )\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ----------------------------\n",
    "# Helpers\n",
